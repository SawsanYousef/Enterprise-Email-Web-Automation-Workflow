89-a4c1-0ffb4b5f1946</processid></stage><stage stageid="762d27f6-5a86-4249-afb3-3ba175115366" name="mark as completed" type="SubSheet"><loginhibit onsuccess="true" /><display x="150" y="315" w="90" h="60" /><onsuccess>f9dfb673-4f2a-4190-a44f-ce82aa4663b0</onsuccess><processid>2fbcd008-835d-4f89-9cb9-1cc2ca8adf1f</processid></stage><stage stageid="f9dfb673-4f2a-4190-a44f-ce82aa4663b0" name="reload page" type="SubSheet"><loginhibit onsuccess="true" /><display x="360" y="315" w="90" h="60" /><onsuccess>6bbad723-f5af-4bbe-858c-6ad3a42fd662</onsuccess><processid>e131c920-557d-47a7-90b4-9137c5b8b436</processid></stage><stage stageid="28cd898e-5982-48d1-b46b-8d83308e4855" name="mark as exception" type="SubSheet"><loginhibit onsuccess="true" /><display x="150" y="570" w="90" h="60" /><onsuccess>2bd87acc-ae3b-4a08-95a1-96a6b98243a0</onsuccess><processid>372cffda-2563-419d-aded-d0b907235de4</processid></stage><stage stageid="20ecc72a-a140-4abd-b22b-e2af1e23c4b3" name="Get Next Item" type="Action"><narrative>This action gets the next item to be worked from the queue, returning its details and locking it so no other case can work it.

Items with higher priorities (lower numerical value) are processed first. Where the priority is the same, the next item is the one that has been in the queue the longest,  is not already locked, and is not already completed.

The Item ID returned is used to make further calls to update the work status for that item. It may be empty, in which case there are no items available. This can mean either a) the queue is empty, or b) the queue is not running. This mechanism can be used to cleanly stop all processes working a particular queue at the end of the next case. Items that have a 'deferred' time set will not be returned unless that time has been reached.</narrative><display x="135" y="120" w="150" h="60" /><inputs><input type="text" name="Queue Name" friendlyname="Queue Name" narrative="The name of the queue" expr="[Variabels.queue_name]" /><input type="text" name="Key Filter" friendlyname="Key Filter" narrative="Optionally, a key value to filter by. Only items with this key value will be considered." expr="" /><input type="text" name="Tag Filter" friendlyname="Tag Filter" narrative="Optionally, a tag mask to filter by. This can consist of any number of tag searches - each term can be separated by a semi-colon and they are all applied to the search (ie. they are AND'ed terms not OR'ed terms). For example, &quot;Account: Joint; -Balance: Overdrawn; Card: *Visa*&quot; will include any items which match all the terms, ie. every item must have an 'Account: Joint' tag applied, no item can have a 'Balance: Overdrawn' tag applied, every item must have a tag applied which starts with 'Card: ' and then contains the text 'Visa'." expr="&quot;P1 Completed&quot;" /><input type="text" name="Sort Order" friendlyname="Sort Order" narrative="Sort order method (Priority, SLA, PriorityAndSLA)" lookupValue="Priority" lookupType="WorkQueueSortTypes" /></inputs><outputs><output type="text" name="Item ID" friendlyname="Item ID" narrative="The ID of the item retrieved - empty if there are none available." stage="Item ID" /><output type="collection" name="Data" friendlyname="Data" narrative="The data associated with the item - a single collection row." stage="Data" /><output type="text" name="Status" friendlyname="Status" narrative="The status of the item." stage="Status" /><output type="number" name="Attempts" friendlyname="Attempts" narrative="The number of attempts already made to work this item." stage="" /></outputs><onsuccess>ca381cd0-6d29-45ff-b6ec-6983834ac74d</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Get Next Item" /></stage><stage stageid="4ef29a15-d92c-416c-95cb-e3acf358f908" name="Stop?" type="Decision"><display x="360" y="120" w="120" h="60" /><font family="Tahoma" size="10" style="Bold" color="FF0000" /><decision expression="IsStopRequested() OR [Stop After Items]=0 OR LocalTime()&gt;[Stop After Time]" /><ontrue>46570e06-501f-4445-9d01-c312070b0711</ontrue><onfalse>20ecc72a-a140-4abd-b22b-e2af1e23c4b3</onfalse></stage><stage stageid="6d8bb83f-dbe6-4fc0-97b9-aa22ef438477" name="Stop After Time" type="Data"><narrative>Used by the process to decide whether to keep working or close itself down. This value can be modified from Control Room to bring a session to an early finish.</narrative><display x="570" y="120" w="150" h="30" /><font family="Tahoma" size="10" style="Bold" color="FF0000" /><datatype>time</datatype><initialvalue>16:50:00</initialvalue><exposure>Session</exposure><private /><alwaysinit /></stage><stage stageid="78e715fc-9982-4dca-bfe1-6c31ee188654" name="Stop After Items" type="Data"><narrative>Used by the process to decide whether to keep working or close itself down. This value can be modified from Control Room to bring a session to an early finish.</narrative><display x="570" y="150" w="150" h="30" /><font family="Tahoma" size="10" style="Bold" color="FF0000" /><datatype>number</datatype><initialvalue>9999999999</initialvalue><exposure>Session</exposure><private /><alwaysinit /></stage><stage stageid="cd40c05d-02a7-4c8b-ac34-83c64419591a" name="Stopping Control Settings" type="Block"><display x="480" y="75" w="180" h="105" /><font family="Tahoma" size="10" style="Regular" color="FF0000" /></stage><stage stageid="46570e06-501f-4445-9d01-c312070b0711" name="terminate" type="SubSheet"><loginhibit onsuccess="true" /><display x="360" y="30" w="90" h="60" /><onsuccess>845b7588-6839-4037-879d-2833caf1fae8</onsuccess><processid>c845b281-3a33-4f59-b30f-18824c9f8bd0</processid></stage><stage stageid="845b7588-6839-4037-879d-2833caf1fae8" name="filter collection" type="SubSheet"><loginhibit onsuccess="true" /><display x="360" y="-60" w="90" h="60" /><onsuccess>8b203397-22ff-4f2b-8e69-d2bb60041a2b</onsuccess><processid>9ede26bf-e6da-4024-bc97-6a0e2ae0578b</processid></stage><stage stageid="8b203397-22ff-4f2b-8e69-d2bb60041a2b" name="write to excel" type="SubSheet"><loginhibit onsuccess="true" /><display x="360" y="-150" w="90" h="60" /><onsuccess>13be0345-52dd-4c41-8f82-7072c7af9a75</onsuccess><processid>f7694392-a6fd-42b2-b80e-6312cd808447</processid></stage><stage stageid="13be0345-52dd-4c41-8f82-7072c7af9a75" name="send report" type="SubSheet"><loginhibit onsuccess="true" /><display x="210" y="-150" w="90" h="60" /><onsuccess>9ea72c4a-9ae0-48dc-9088-eeee45b3c8d3</onsuccess><processid>dbde8e71-7b2c-4158-87dd-43071590f9c9</processid></stage><stage stageid="8cbd9d68-f7c3-4c26-be0d-8eea32b1c133" name="Anchor1" type="Anchor"><loginhibit onsuccess="true" /><display x="-90" y="30" w="10" h="10" /><onsuccess>46570e06-501f-4445-9d01-c312070b0711</onsuccess></stage><stage stageid="2ec8f6b6-3c02-4063-869e-92b3d8c5cf9b" name="Global Recover" type="Recover"><loginhibit /><display x="-420" y="270" /><onsuccess>60988f3f-92b5-44e2-8981-f07b34a67566</onsuccess></stage><stage stageid="6ee449c8-2721-44f5-aab3-1a32ad8d7ddd" name="Terminate" type="Exception"><display x="-420" y="480" w="120" h="30" /><exception localized="yes" type="" detail="" usecurrent="yes" /></stage><stage stageid="60988f3f-92b5-44e2-8981-f07b34a67566" name="Exception items" type="MultipleCalculation"><loginhibit onsuccess="true" /><display x="-420" y="345" w="90" h="60" /><onsuccess>0d64517f-4647-4bea-b0a0-45b26417ea4a</onsuccess><steps><calculation expression="ExceptionDetail()" stage="Exception Detail" /><calculation expression="ExceptionType()" stage="Exception Type" /></steps></stage><stage stageid="f32a8bb1-5694-4fe8-89c2-1a0016fbc2b8" name="Exception Type" type="Data"><subsheetid>be48d5b4-34dd-4226-81ae-beb5dbab3875</subsheetid><display x="-195" y="-30" w="90" h="30" /><datatype>text</datatype><initialvalue /><alwaysinit /></stage><stage stageid="917d6fca-9664-4993-867d-33e4f3f85b91" name="Exception Detail" type="Data"><subsheetid>be48d5b4-34dd-4226-81ae-beb5dbab3875</subsheetid><display x="-195" y="30" w="90" h="30" /><datatype>text</datatype><initialvalue /><alwaysinit /></stage><stage stageid="4b1b93f9-5908-4d9c-8ae2-6cd3855cebcb" name="queue data" type="Block"><subsheetid>be48d5b4-34dd-4226-81ae-beb5dbab3875</subsheetid><loginhibit onsuccess="true" /><display x="-15" y="-105" w="150" h="195" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="51e77fe3-7ec2-4362-9daa-64235600aae2" name="exceptions" type="Block"><subsheetid>be48d5b4-34dd-4226-81ae-beb5dbab3875</subsheetid><loginhibit onsuccess="true" /><display x="-255" y="-60" w="120" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="f539aae1-f715-46a5-aaf0-b3af0d742e3e" name="Start" type="Start"><subsheetid>2fbcd008-835d-4f89-9cb9-1cc2ca8adf1f</subsheetid><display x="-45" y="-255" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>8c4d8ebd-6ef8-46b7-a134-484148486e5e</onsuccess></stage><stage stageid="50080820-4dcd-4bf0-ac09-182216fb1f74" name="Mark Completed" type="Action"><subsheetid>2fbcd008-835d-4f89-9cb9-1cc2ca8adf1f</subsheetid><narrative>Marks the item as completed, by updating the Completed timestamp and setting Locked to null. The item must be 'owned' by the calling process - i.e. it must have been retrieved using Get Next Item.</narrative><display x="-45" y="-15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Item ID" narrative="The ID of the item to mark" expr="[Item ID]" /></inputs><onsuccess>825eff7d-4061-4b0f-9435-0dea27dcff98</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Mark Completed" /></stage><stage stageid="8c4d8ebd-6ef8-46b7-a134-484148486e5e" name="Set Status" type="Action"><subsheetid>2fbcd008-835d-4f89-9cb9-1cc2ca8adf1f</subsheetid><narrative>Updates the status field for the item. The status field can be used to flag what has been done in a process so far. If a process encounters an exception, this information can be used to skip to the parts of the process not yet done for the item next time it is worked. The item must be 'owned' by the calling process - i.e. it must have been retrieved using Get Next Item.

This action will also reset the Attempts column to zero, because if the status updated the process should have successfully done something.</narrative><display x="-45" y="-195" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Item ID" narrative="The ID of the item to mark" expr="[Item ID]" /><input type="text" name="Status" narrative="The new status - 255 characters maximum." expr="&quot;Completed&quot;" /></inputs><onsuccess>6a5bf860-d28d-4ada-93c7-ef620d36d135</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Update Status" /></stage><stage stageid="825eff7d-4061-4b0f-9435-0dea27dcff98" name="Reset Consecutive Exception Indicators" type="MultipleCalculation"><subsheetid>2fbcd008-835d-4f89-9cb9-1cc2ca8adf1f</subsheetid><display x="-45" y="75" w="120" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>d8bbd797-305b-45f7-9313-a8968f80d196</onsuccess><steps><calculation expression="&quot;&quot;" stage="Previous Exception Detail" /><calculation expression="0" stage="Consecutive Exception Count" /></steps></stage><stage stageid="d8bbd797-305b-45f7-9313-a8968f80d196" name="End3" type="End"><subsheetid>2fbcd008-835d-4f89-9cb9-1cc2ca8adf1f</subsheetid><display x="-45" y="165" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="03e545ba-f554-4e54-a873-b238262f0b39" name="Tag Item" type="Action"><subsheetid>2fbcd008-835d-4f89-9cb9-1cc2ca8adf1f</subsheetid><loginhibit onsuccess="true" /><narrative>Adds a tag to a work queue item</narrative><display x="-45" y="-75" w="120" h="30" /><inputs><input type="text" name="Item ID" friendlyname="Item ID" narrative="The ID of the queue item to add the tag to" expr="[Item ID]" /><input type="text" name="Tag" friendlyname="Tag" narrative="The tag to add to the item. Note that this cannot start with a '+' (plus) or '-' (minus) character, and cannot contain ';' (semi-colon) characters" expr="[Tag]" /></inputs><onsuccess>50080820-4dcd-4bf0-ac09-182216fb1f74</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Tag Item" /></stage><stage stageid="a52c0850-7700-4515-8731-4e51f82e5a46" name="Tag" type="Data"><subsheetid>2fbcd008-835d-4f89-9cb9-1cc2ca8adf1f</subsheetid><loginhibit onsuccess="true" /><display x="-285" y="30" /><datatype>text</datatype><initialvalue xml:space="preserve">Completed</initialvalue><private /><alwaysinit /></stage><stage stageid="70e6a06c-f59e-4d15-801d-393150a034c4" name="Start" type="Start"><subsheetid>372cffda-2563-419d-aded-d0b907235de4</subsheetid><display x="-60" y="-240" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>d9ba36db-8ea8-480f-98da-8079c000d6ac</onsuccess></stage><stage stageid="69709394-9a86-48cb-a994-283049b70685" name="Retry Exception?" type="Decision"><subsheetid>372cffda-2563-419d-aded-d0b907235de4</subsheetid><display x="-60" y="-90" w="90" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="Lower([Exception Type])=&quot;system exception&quot; OR Lower([Exception Type])=&quot;internal&quot;" /><ontrue>6e9c4d59-9dd1-417d-a690-1fae22e43721</ontrue><onfalse>a62fa548-a98f-4920-a9a2-71bbf14d9433</onfalse></stage><stage stageid="04397a7f-04c4-4495-a07e-b63797ffce35" name="Previous Exception?" type="Decision"><subsheetid>372cffda-2563-419d-aded-d0b907235de4</subsheetid><display x="-60" y="105" w="90" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="[Previous Exception Detail]=[Exception Detail]" /><ontrue>061f1510-31c6-4334-9ddf-c9123a678292</ontrue><onfalse>b69e41ed-47d2-43b7-90df-106418d53a6d</onfalse></stage><stage stageid="569a1f4c-3552-4259-bc40-db593216adf3" name="Previous Exception Detail" type="Data"><subsheetid>372cffda-2563-419d-aded-d0b907235de4</subsheetid><display x="-300" y="45" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /></stage><stage stageid="061f1510-31c6-4334-9ddf-c9123a678292" name="Count" type="Calculation"><subsheetid>372cffda-2563-419d-aded-d0b907235de4</subsheetid><display x="-60" y="180" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>e56b3991-2224-4d2d-be9e-c7e5b05a61fa</onsuccess><calculation expression="1+ [Consecutive Exception Count]" stage="Consecutive Exception Count" /></stage><stage stageid="3b0de34a-29a0-4221-979d-fdb51bc33932" name="Consecutive Exception Count" type="Data"><subsheetid>372cffda-2563-419d-aded-d0b907235de4</subsheetid><display x="-300" y="75" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue></stage><stage stageid="e56b3991-2224-4d2d-be9e-c7e5b05a61fa" name="Limit?" type="Decision"><subsheetid>372cffda-2563-419d-aded-d0b907235de4</subsheetid><display x="-60" y="255" w="90" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="[Consecutive Exception Count]&gt;=[Consecutive Exception Limit]" /><ontrue>a7397e10-3847-40e3-8ab1-8cd97e5604fc</ontrue><onfalse>4adea70b-cf6f-4399-a626-85e630df4e75</onfalse></stage><stage stageid="a7397e10-3847-40e3-8ab1-8cd97e5604fc" name="TERMINATE" type="Exception"><subsheetid>372cffda-2563-419d-aded-d0b907235de4</subsheetid><display x="-60" y="345" w="120" h="60" /><font family="Tahoma" size="10" style="Bold" color="FF0000" /><exception type="" detail="[Consecutive Exception Limit] &amp; &quot; consecutive incidents of &quot; &amp; [Exception Type] &amp; &quot;: &quot; &amp; [Exception Detail]" /></stage><stage stageid="e4892e8b-7f59-455d-b763-14584c27dd1a" name="Consecutive Exception Limit" type="Data"><subsheetid>372cffda-2563-419d-aded-d0b907235de4</subsheetid><display x="-300" y="105" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>3</initialvalue><private /><alwaysinit /></stage><stage stageid="4adea70b-cf6f-4399-a626-85e630df4e75" name="End2" type="End"><subsheetid>372cffda-2563-419d-aded-d0b907235de4</subsheetid><display x="210" y="255" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="b69e41ed-47d2-43b7-90df-106418d53a6d" name="Reset Consecutive Exception Indicators" type="MultipleCalculation"><subsheetid>372cffda-2563-419d-aded-d0b907235de4</subsheetid><display x="210" y="105" w="90" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>4adea70b-cf6f-4399-a626-85e630df4e75</onsuccess><steps><calculation expression="[Exception Detail]" stage="Previous Exception Detail" /><calculation expression="0" stage="Consecutive Exception Count" /></steps></stage><stage stageid="17f149ce-9b45-4a42-833c-f41d4be576d8" name="New Item ID" type="Data"><subsheetid>372cffda-2563-419d-aded-d0b907235de4</subsheetid><display x="-300" y="-15" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1f782842-2090-41ee-9423-c248fc51d229" name="Tag Item" type="Action"><subsheetid>372cffda-2563-419d-aded-d0b907235de4</subsheetid><narrative>Adds a tag to a work queue item</narrative><display x="135" y="-90" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Item ID" narrative="The ID of the queue item to add the tag to" expr="[Item ID]" /><input type="text" name="Tag" narrative="The tag to add to the item. Note that this cannot start with a '+' (plus) or '-' (minus) character, and cannot contain ';' (semi-colon) characters" expr="&quot;Business Exception&quot;" /></inputs><onsuccess>b0019d3d-cf4c-48f4-ac69-0c3850bd7a2b</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Tag Item" /></stage><stage stageid="0506e99b-e671-40bc-a85a-d848ffd2b4df" name="Reset Consecutive Exception Indicators" type="MultipleCalculation"><subsheetid>372cffda-2563-419d-aded-d0b907235de4</subsheetid><display x="420" y="-90" w="90" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>3b05ad6e-194c-45df-b123-e75e0d768b9a</onsuccess><steps><calculation expression="&quot;&quot;" stage="Previous Exception Detail" /><calculation expression="0" stage="Consecutive Exception Count" /></steps></stage><stage stageid="f43f0c27-f167-4652-8db5-140d0cd4c82f" name="Mark Exception" type="Action"><subsheetid>372cffda-2563-419d-aded-d0b907235de4</subsheetid><narrative>Marks the item as an exception, optionally retrying it by cloning the item and returning the ID of the clone. The item must be 'owned' by the calling process - i.e. it must have been retrieved using Get Next Item.</narrative><display x="-60" y="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Item ID" narrative="The ID of the item to mark" expr="[Item ID]" /><input type="text" name="Exception Reason" narrative="A description of the reason for the exception" expr="[Exception Detail]" /><input type="flag" name="Retry" narrative="Whether or not to retry the item, up to the maximum number of attempts specified for the queue. Optional - if not specified, the item will be retried" expr="True" /><input type="flag" name="Keep Locked" narrative="Whether or not the clone of the item should remain locked after the exception has been registered and the item is retried. Optional - default is False" expr="False" /></inputs><outputs><output type="text" name="New Item ID" narrative="The Item ID of the newly cloned item. This item will be locked if 'Keep Locked' is True. This will be empty if no item was cloned (ie. the item was not retried." stage="New Item ID" /></outputs><onsuccess>04397a7f-04c4-4495-a07e-b63797ffce35</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Mark Exception" /></stage><stage stageid="ff2ef830-622a-43ae-b771-b281f8556991" name="Mark Exception" type="Action"><subsheetid>372cffda-2563-419d-aded-d0b907235de4</subsheetid><narrative>Marks the item as an exception, optionally retrying it by cloning the item and returning the ID of the clone. The item must be 'owned' by the calling process - i.e. it must have been retrieved using Get Next Item.</narrative><display x="315" y="-90" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Item ID" narrative="The ID of the item to mark" expr="[Item ID]" /><input type="text" name="Exception Reason" narrative="A description of the reason for the exception" expr="[Exception Detail]" /><input type="flag" name="Retry" narrative="Whether or not to retry the item, up to the maximum number of attempts specified for the queue. Optional - if not specified, the item will be retried" expr="False" /><input type="flag" name="Keep Locked" narrative="Whether or not the clone of the item should remain locked after the exception has been registered and the item is retried. Optional - default is False" expr="False" /></inputs><outputs><output type="text" name="New Item ID" narrative="The Item ID of the newly cloned item. This item will be locked if 'Keep Locked' is True. This will be empty if no item was cloned (ie. the item was not retried." stage="New Item ID" /></outputs><onsuccess>0506e99b-e671-40bc-a85a-d848ffd2b4df</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Mark Exception" /></stage><stage stageid="3b05ad6e-194c-45df-b123-e75e0d768b9a" name="End1" type="End"><subsheetid>372cffda-2563-419d-aded-d0b907235de4</subsheetid><display x="525" y="-90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="6e9c4d59-9dd1-417d-a690-1fae22e43721" name="Tag Item" type="Action"><subsheetid>372cffda-2563-419d-aded-d0b907235de4</subsheetid><narrative>Adds a tag to a work queue item</narrative><display x="-60" y="-30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Item ID" narrative="The ID of the queue item to add the tag to" expr="[Item ID]" /><input type="text" name="Tag" narrative="The tag to add to the item. Note that this cannot start with a '+' (plus) or '-' (minus) character, and cannot contain ';' (semi-colon) characters" expr="&quot;System Exception&quot;" /></inputs><onsuccess>f43f0c27-f167-4652-8db5-140d0cd4c82f</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Tag Item" /></stage><stage stageid="d9ba36db-8ea8-480f-98da-8079c000d6ac" name="System Unavailable?" type="Decision"><subsheetid>372cffda-2563-419d-aded-d0b907235de4</subsheetid><display x="-60" y="-165" w="90" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="Lower([Exception Type])=&quot;system unavailable exception&quot; OR Lower([Exception Type])=&quot;login system exception&quot;" /><ontrue>77e70cdc-5a1e-4d0f-85fb-cc0552623aea</ontrue><onfalse>69709394-9a86-48cb-a994-283049b70685</onfalse></stage><stage stageid="77e70cdc-5a1e-4d0f-85fb-cc0552623aea" name="Release Item" type="Action"><subsheetid>372cffda-2563-419d-aded-d0b907235de4</subsheetid><narrative>Marks the item as deferred. It is unlocked, but it will not be made available for processing again until the specified time.

The attempts count for the item is reset to zero.</narrative><display x="-195" y="-165" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Item ID" narrative="The ID of the item to defer" expr="[Item ID]" /><input type="datetime" name="Until" narrative="When to resume processing the case" expr="Now()" /></inputs><onsuccess>b4854537-422e-4e74-ba3a-57281882e7a5</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Defer" /></stage><stage stageid="b4854537-422e-4e74-ba3a-57281882e7a5" name="TERMINATE" type="Exception"><subsheetid>372cffda-2563-419d-aded-d0b907235de4</subsheetid><display x="-195" y="-90" w="120" h="60" /><font family="Tahoma" size="10" style="Bold" color="FF0000" /><exception type="" detail="[Consecutive Exception Limit] &amp; &quot; consecutive incidents of &quot; &amp; [Exception Type] &amp; &quot;: &quot; &amp; [Exception Detail]" /></stage><stage stageid="b0019d3d-cf4c-48f4-ac69-0c3850bd7a2b" name="Set Status" type="Action"><subsheetid>372cffda-2563-419d-aded-d0b907235de4</subsheetid><loginhibit onsuccess="true" /><narrative>Updates the status field for the item. The status field can be used to flag what has been done in a process so far. If a process encounters an exception, this information can be used to skip to the parts of the process not yet done for the item next time it is worked. The item must be 'owned' by the calling process - i.e. it must have been retrieved using Get Next Item.

This action will also reset the Attempts column to zero, because if the status updated the process should have successfully done something.</narrative><display x="225" y="-90" /><inputs><input type="text" name="Status" friendlyname="Status" narrative="The new status - 255 characters maximum." expr="&quot;BE: &quot;&amp;[Exception Detail]" /><input type="text" name="Item ID" friendlyname="Item ID" narrative="The ID of the item to mark" expr="[Item ID]" /></inputs><onsuccess>ff2ef830-622a-43ae-b771-b281f8556991</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Update Status" /></stage><stage stageid="6bbad723-f5af-4bbe-858c-6ad3a42fd662" name="reset global data" type="SubSheet"><loginhibit onsuccess="true" /><display x="360" y="225" w="90" h="60" /><onsuccess>4ef29a15-d92c-416c-95cb-e3acf358f908</onsuccess><processid>be48d5b4-34dd-4226-81ae-beb5dbab3875</processid></stage><stage stageid="5d14e007-15a7-42e1-93ac-be05a914cd6a" name="Start" type="Start"><subsheetid>9ede26bf-e6da-4024-bc97-6a0e2ae0578b</subsheetid><display x="-90" y="-285" /><onsuccess>9f5c05bb-7379-4e40-8a68-cd0dd70ef68b</onsuccess></stage><stage stageid="6bbd7a60-7d43-4589-85bf-d284f019f1b3" name="End" type="End"><subsheetid>9ede26bf-e6da-4024-bc97-6a0e2ae0578b</subsheetid><display x="-90" y="135" /></stage><stage stageid="1ee53f25-035d-4481-928c-5a08afc2ea2d" name="Filter Collection" type="Action"><subsheetid>9ede26bf-e6da-4024-bc97-6a0e2ae0578b</subsheetid><loginhibit onsuccess="true" /><display x="-90" y="-105" w="90" h="30" /><inputs><input type="collection" name="Collection In" friendlyname="Collection In" narrative="The collection to filter." expr="[passwords evaluation]" /><input type="text" name="Filter" friendlyname="Filter" narrative="The filter query." expr="&quot;[Password strength]='&quot; &amp;[strength types.Strength type]&amp;&quot;'&quot;" /></inputs><outputs><output type="collection" name="Collection Out" friendlyname="Collection Out" narrative="The filtered collection." stage="Evaluations with Strength Type" /></outputs><onsuccess>786ab124-fe8c-4c82-b09e-924064137465</onsuccess><resource object="Utility - Collection Manipulation" action="Filter Collection" /></stage><stage stageid="2f9091ea-b762-41cc-a561-efd86574c69e" name="Evaluations with Strength Type" type="Collection"><subsheetid>9ede26bf-e6da-4024-bc97-6a0e2ae0578b</subsheetid><display x="-330" y="-45" w="120" h="60" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="7954147d-695b-4c2a-aa83-1db3ea0d820e" name="strength types" type="Collection"><subsheetid>9ede26bf-e6da-4024-bc97-6a0e2ae0578b</subsheetid><display x="-330" y="-180" w="120" h="60" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><field name="Strength type" type="text" /></collectioninfo><initialvalue><row><field name="Strength type" type="text" value="Very Weak" /></row><row><field name="Strength type" type="text" value="Weak" /></row><row><field name="Strength type" type="text" value="Good" /></row><row><field name="Strength type" type="text" value="Strong" /></row></initialvalue></stage><stage stageid="f61e10a0-f59c-4429-a984-38ad4235ba13" name="Loop End1" type="LoopEnd"><subsheetid>9ede26bf-e6da-4024-bc97-6a0e2ae0578b</subsheetid><loginhibit onsuccess="true" /><display x="-90" y="75" w="150" h="30" /><onsuccess>6bbd7a60-7d43-4589-85bf-d284f019f1b3</onsuccess><groupid>ffa5ea07-e991-45d4-ba7b-053cf22e30da</groupid></stage><stage stageid="9f5c05bb-7379-4e40-8a68-cd0dd70ef68b" name="Loop Start1" type="LoopStart"><subsheetid>9ede26bf-e6da-4024-bc97-6a0e2ae0578b</subsheetid><loginhibit onsuccess="true" /><display x="-90" y="-225" w="150" h="30" /><onsuccess>fac15ab7-8e1b-4954-9773-0f3c62c369c2</onsuccess><groupid>ffa5ea07-e991-45d4-ba7b-053cf22e30da</groupid><looptype>ForEach</looptype><loopdata>strength types</loopdata></stage><stage stageid="786ab124-fe8c-4c82-b09e-924064137465" name="Count Rows" type="Action"><subsheetid>9ede26bf-e6da-4024-bc97-6a0e2ae0578b</subsheetid><loginhibit onsuccess="true" /><display x="-90" y="-45" w="90" h="30" /><inputs><input type="text" name="Collection Name" friendlyname="Collection Name" narrative="The name of the collection to act upon" expr="&quot;Evaluations with Strength Type&quot;" /></inputs><outputs><output type="number" name="Count" friendlyname="Count" narrative="The number of rows counted in the collection" stage="Evaluations counts.count" /></outputs><onsuccess>07815f20-0a97-4204-b7c9-5a0f1c2e7181</onsuccess><resource object="Blueprism.AutomateProcessCore.clsCollectionActions" action="Count Rows" /></stage><stage stageid="f82b8709-a179-4c9e-921d-5403de984bf9" name="Evaluations counts" type="Collection"><subsheetid>9ede26bf-e6da-4024-bc97-6a0e2ae0578b</subsheetid><display x="-330" y="45" w="120" h="60" /><datatype>collection</datatype><alwaysinit /><collectioninfo><field name="strength type" type="text" /><field name="count" type="number" /></collectioninfo></stage><stage stageid="fac15ab7-8e1b-4954-9773-0f3c62c369c2" name="Add Row" type="Action"><subsheetid>9ede26bf-e6da-4024-bc97-6a0e2ae0578b</subsheetid><loginhibit onsuccess="true" /><display x="-90" y="-165" w="90" h="30" /><inputs><input type="text" name="Collection Name" friendlyname="Collection Name" narrative="The name of the collection to act upon" expr="&quot;Evaluations counts&quot;" /></inputs><onsuccess>1ee53f25-035d-4481-928c-5a08afc2ea2d</onsuccess><resource object="Blueprism.AutomateProcessCore.clsCollectionActions" action="Add Row" /></stage><stage stageid="07815f20-0a97-4204-b7c9-5a0f1c2e7181" name="get strength type" type="Calculation"><subsheetid>9ede26bf-e6da-4024-bc97-6a0e2ae0578b</subsheetid><loginhibit onsuccess="true" /><display x="-90" y="15" w="90" h="30" /><onsuccess>f61e10a0-f59c-4429-a984-38ad4235ba13</onsuccess><calculation expression="[strength types.Strength type]" stage="Evaluations counts.strength type" /></stage><stage stageid="f4cca3da-ef5b-4a5f-bcbb-c18cd6709e23" name="outputs" type="Block"><subsheetid>9ede26bf-e6da-4024-bc97-6a0e2ae0578b</subsheetid><loginhibit onsuccess="true" /><display x="-405" y="-90" w="150" h="180" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="21baa7c9-747b-403a-8357-7d1aea1fe6c5" name="input" type="Block"><subsheetid>9ede26bf-e6da-4024-bc97-6a0e2ae0578b</subsheetid><loginhibit onsuccess="true" /><display x="-405" y="-225" w="150" h="90" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="61ced071-0d9c-4765-aab4-3ec81cccb176" name="Block2" type="Block"><subsheetid>9ede26bf-e6da-4024-bc97-6a0e2ae0578b</subsheetid><loginhibit onsuccess="true" /><display x="-180" y="-195" w="255" h="240" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="4d6866ef-38a5-422a-9353-bd8f5c442878" name="Recover" type="Recover"><subsheetid>9ede26bf-e6da-4024-bc97-6a0e2ae0578b</subsheetid><loginhibit /><display x="15" y="-90" /><onsuccess>ad0d1590-e010-4173-9131-69c17dd89ecf</onsuccess></stage><stage stageid="ad0d1590-e010-4173-9131-69c17dd89ecf" name="Rethrow" type="Exception"><subsheetid>9ede26bf-e6da-4024-bc97-6a0e2ae0578b</subsheetid><display x="150" y="-90" w="90" h="30" /><exception localized="yes" type="" detail="" usecurrent="yes" /></stage><stage stageid="cc990446-ea02-434b-8b2e-a0af6e3ddc80" name="Start" type="Start"><subsheetid>f7694392-a6fd-42b2-b80e-6312cd808447</subsheetid><display x="-90" y="-285" /><onsuccess>d279c142-c394-4986-86d1-5f61e56c40b4</onsuccess></stage><stage stageid="3e56f5be-9a5a-454a-86cc-46cafe1c055b" name="End" type="End"><subsheetid>f7694392-a6fd-42b2-b80e-6312cd808447</subsheetid><display x="-90" y="240" /></stage><stage stageid="d279c142-c394-4986-86d1-5f61e56c40b4" name="Create Instance" type="Action"><subsheetid>f7694392-a6fd-42b2-b80e-6312cd808447</subsheetid><loginhibit onsuccess="true" /><display x="-90" y="-225" w="90" h="30" /><inputs><input type="flag" name="Enable Events" friendlyname="Enable Events" narrative="Flag to indicate that events should be enabled / disabled on the attached instance - defaulted to True" expr="" /></inputs><outputs><output type="number" name="handle" friendlyname="handle" narrative="An integer which can be used to identify the created instance in subsequent actions" stage="handle" /></outputs><onsuccess>a294256a-5328-4231-8e84-5607fba8d2fc</onsuccess><resource object="MS Excel VBO" action="Create Instance" /></stage><stage stageid="4134ca4b-59e3-47de-904c-0575898b5ae7" name="Show" type="Action"><subsheetid>f7694392-a6fd-42b2-b80e-6312cd808447</subsheetid><loginhibit onsuccess="true" /><display x="-90" y="-135" w="90" h="30" /><inputs><input type="number" name="handle" friendlyname="handle" narrative="The integer handle identifying the instance which should have its window displayed. The default of zero indicates the currently active instance." expr="[handle]" /></inputs><onsuccess>b835891c-5b37-4c35-960b-884553445fed</onsuccess><resource object="MS Excel VBO" action="Show" /></stage><stage stageid="a294256a-5328-4231-8e84-5607fba8d2fc" name="Create Workbook" type="Action"><subsheetid>f7694392-a6fd-42b2-b80e-6312cd808447</subsheetid><loginhibit onsuccess="true" /><display x="-90" y="-180" w="90" h="30" /><inputs><input type="number" name="handle" friendlyname="handle" narrative="The integer handle identifying the instance on which the required workbook should be opened. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="File name" friendlyname="File name" narrative="The path and name of the file which should be opened." expr="[Variabels.excel_path]" /><input type="number" name="Timeout" friendlyname="Timeout" narrative="The time available for the action to complete." expr="" /><input type="text" name="Password" friendlyname="Password" narrative="Optional. The password required to open the workbook. This only applies to workbooks that were saved with a password." expr="" /><input type="flag" name="Update Links" friendlyname="Update Links" narrative="Optional. Flag that controls whether external references (links) in the file, such as the reference to other Workbooks, are updated. Default value is True." expr="" /></inputs><outputs><output type="text" name="Workbook Name" friendlyname="Workbook Name" narrative="The name used by Excel to identify the workbook - usually this is the file name (without the path)." stage="Workbook Name" /></outputs><onsuccess>4134ca4b-59e3-47de-904c-0575898b5ae7</onsuccess><resource object="MS Excel VBO" action="Open Workbook" /></stage><stage stageid="6600efce-15ff-4e2b-aefb-e231d82eb18c" name="Close Workbook" type="Action"><subsheetid>f7694392-a6fd-42b2-b80e-6312cd808447</subsheetid><loginhibit onsuccess="true" /><display x="-90" y="135" w="90" h="30" /><inputs><input type="number" name="handle" friendlyname="handle" narrative="The integer handle identifying the instance on which the workbook which should be closed resides. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="Workbook Name" friendlyname="Workbook Name" narrative="The name of the workbook which should be closed." expr="[New Workbook Name]" /><input type="flag" name="Save Data" friendlyname="Save Data" narrative="True to save the data before closing the workbook; The default of False will discard any changes before closing the workbook." expr="" /><input type="number" name="Timeout" friendlyname="Timeout" narrative="The timeout value for the function to complete." expr="" /></inputs><onsuccess>50652911-f1d9-44af-b7f8-9037de5f2559</onsuccess><resource object="MS Excel VBO" action="Close Workbook" /></stage><stage stageid="50652911-f1d9-44af-b7f8-9037de5f2559" name="Close Instance" type="Action"><subsheetid>f7694392-a6fd-42b2-b80e-6312cd808447</subsheetid><loginhibit onsuccess="true" /><display x="-90" y="180" w="90" h="30" /><inputs><input type="number" name="handle" friendlyname="handle" narrative="The integer handle identifying the instance to be closed. Zero indicates the currently active instance." expr="[handle]" /><input type="flag" name="Save Changes" friendlyname="Save Changes" narrative="True to save the changes to the open workbooks on the instance, False to discard any changes. Default is False." expr="" /><input type="number" name="Timeout" friendlyname="Timeout" narrative="The time for the action to complete. Default is 30. Minimum is 10." expr="" /></inputs><onsuccess>3e56f5be-9a5a-454a-86cc-46cafe1c055b</onsuccess><resource object="MS Excel VBO" action="Close Instance" /></stage><stage stageid="526fd5f2-d53e-41ce-8243-ac9cb42c50fc" name="handle" type="Data"><subsheetid>f7694392-a6fd-42b2-b80e-6312cd808447</subsheetid><display x="-390" y="-45" w="90" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="46e63301-8f20-44ac-a783-c8e36c88604f" name="Workbook Name" type="Data"><subsheetid>f7694392-a6fd-42b2-b80e-6312cd808447</subsheetid><display x="-405" y="0" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="38d24f2b-b490-4696-b4fa-ec3fe4cda62c" name="Create Worksheet" type="Action"><subsheetid>f7694392-a6fd-42b2-b80e-6312cd808447</subsheetid><loginhibit onsuccess="true" /><display x="-90" y="0" w="90" h="30" /><inputs><input type="number" name="handle" friendlyname="handle" narrative="The integer handle identifying the instance on which the worksheet should be created. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="Workbook Name" friendlyname="Workbook Name" narrative="The name of the workbook in which the sheet should be created - The default empty value indicates the currently active workbook on the specified instance." expr="[Workbook Name]" /><input type="text" name="Worksheet Name" friendlyname="Worksheet Name" narrative="The name of the sheet which shoul